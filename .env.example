# Supabase Postgres (use the pooled or direct connection string from the dashboard)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase API (public)
NEXT_PUBLIC_SUPABASE_URL=https://gehjyxyciymdwywjyfyx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Better Auth
BETTER_AUTH_SECRET=
# Optional public app URL for magic links / invite links (defaults to http://localhost:3000)
# BETTER_AUTH_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev auth bypass: phone → real session cookie without Twilio.
# Also enabled automatically when NODE_ENV=development.
# AUTH_DEV_BYPASS=true

# Auth delivery: sms (Twilio Verify) | whatsapp (Cloud API magic link)
# AUTH_DELIVERY=sms
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Google Analytics (post-MVP; leave empty for no-op analytics stub)
NEXT_PUBLIC_GA_ID=
